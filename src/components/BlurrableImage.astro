---
interface Props {
  src: string
  alt?: string
  placeholderDataUri?: string
  widths: number[]
  sizes: string[]
}
const { src, alt = '', placeholderDataUri, widths, sizes } = Astro.props

// 개발 중에는 썸네일 생성기가 아직 안 돌아 placeholder가 치환되지 않은 상태다.
const isDev = placeholderDataUri === 'WILL_BE_REPLACED'

// Cloudinary URL의 /upload/ 를 쪼개 폭별 변형 URL을 만든다. 원본과 동일한 규칙.
const [baseUrl, thumbUrl] = src.split('/upload/')
const srcsetList =
  widths.length && baseUrl && thumbUrl
    ? widths.map((w) => `${baseUrl}/upload/w_${w},q_auto,f_auto/${thumbUrl} ${w}w`)
    : undefined
const srcset = srcsetList?.join(', ')
const computedSrc = srcsetList?.length ? srcsetList[srcsetList.length - 1].split(' ')[0] : src
const computedSizes = sizes.length ? sizes.join(', ') : undefined
---

<div
  class="wrapper"
  style={placeholderDataUri && !isDev ? `background-image:url('${placeholderDataUri}')` : undefined}
>
  <div class="imageWrapper">
    <img src={computedSrc} alt={alt} class="image" loading="lazy" srcset={srcset} sizes={computedSizes} />
  </div>
</div>

<script>
  // 원본의 onMounted 로직. 이미 로드된 이미지도 처리해야 한다.
  for (const img of document.querySelectorAll<HTMLImageElement>('img.image')) {
    if (img.complete) img.style.opacity = '1'
    else img.addEventListener('load', () => (img.style.opacity = '1'), { once: true })
  }
</script>

<style lang="scss">
  .wrapper {
    width: 100%;
    height: 100%;
    background-size: cover;
  }

  .imageWrapper {
    width: 100%;
    height: 100%;
    backdrop-filter: blur(12px);
  }

  .image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
</style>
