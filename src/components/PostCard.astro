---
interface Props {
  title: string
  to: string
  publishedAt?: Date
}
const { title, to, publishedAt } = Astro.props
---

<article class="wrapper">
  <a href={to} class="link">
    {
      publishedAt && (
        <time datetime={publishedAt.toISOString()} class="publishedAt" aria-label="publish date">
          {publishedAt.toLocaleDateString('ko-KR')}
        </time>
      )
    }
    <h2 class="title">{title}</h2>
  </a>
</article>

<style lang="scss">
  // 행 구분선은 목록의 첫 항목 위에는 붙지 않아야 하므로 인접 형제에만 준다.
  // PostCard 인스턴스들은 같은 스코프 해시를 공유하므로 이 선택자가 동작한다.
  .wrapper + .wrapper {
    border-top: 1px solid rgba($grey-0, 0.09);
  }

  .link {
    display: block;
    padding: 26px 0;
    font-size: 1.5rem;

    @media ($desktop) {
      padding: 32px 0;
      font-size: 2rem;
    }

    &:hover .title {
      text-decoration: underline;
    }

    &:hover .publishedAt {
      color: $indigo-3;
    }
  }

  .publishedAt {
    display: block;
    margin-bottom: 10px;
    font-size: 0.8125rem;
    font-weight: 300;
    color: $grey-6;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    transition: color 0.15s ease-in-out;
  }

  .title {
    font-size: inherit;
    font-weight: 600;
    line-height: 1.35;
    color: $grey-0;
    word-break: keep-all;
    text-underline-offset: 7px;
    text-decoration-thickness: 1px;
  }
</style>
