---
import BaseLayout from './BaseLayout.astro'
import '../styles/prose.scss'

interface Props {
  title: string
  publishedAt: Date
}
const { title, publishedAt } = Astro.props
---

<BaseLayout title={title}>
  <main class="article">
    <div>
      <h1>{title}</h1>
      <time class="publishedAt" datetime={publishedAt.toISOString()}>
        {publishedAt.toLocaleDateString('ko-KR')}
      </time>
      <div class="prose">
        <slot />
      </div>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  // pages/blog/[...slug].vue의 .main 그리드를 그대로 옮겼다(24열, 태블릿 3/span20,
  // 데스크톱 7/span12). 원본은 ContentDoc이 만드는 단일 wrapper div가 .main > *의 유일한
  // 자식이어서 이 그리드 배치가 그 div 하나에만 적용됐고, 내부의 h1/time/본문은 모두
  // 그 안에서 보통의 블록 흐름으로 쌓였다.
  //
  // 안쪽의 스타일 없는 <div> wrapper를 지우면 안 된다. h1/time/.prose를 .article의
  // 직접 자식으로 두면 셋 다 그리드 아이템이 되는데, grid item은 서로 마진을 상쇄하지
  // 않는다 — .publishedAt의 margin-bottom(5rem=80px)과 .prose 첫 h2의
  // margin-top(5rem=80px)이 그대로 더해져 160px이 된다. 지금처럼 wrapper div 하나만
  // 그리드 아이템이 되게 하면 그 안은 보통의 블록 흐름이라 둘 중 큰 값(80px)으로
  // 상쇄된다. 그리드 컬럼 배치 자체(24열/3~20/7~12)는 이 wrapper div가 그대로 받는다.
  .article {
    margin: 0 10vw;
    padding: 10rem 0;
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    column-gap: 0.75rem;
    overflow-wrap: break-word;
    word-break: keep-all;

    > * {
      grid-column: 1 / span 24;

      @media ($tablet) {
        grid-column: 3 / span 20;
      }

      @media ($desktop) {
        grid-column: 7 / span 12;
      }
    }
  }

  // ProseH1.vue의 .h1. 글 제목은 이제 프론트매터에서 바로 렌더되며(본문 마크다운에는
  // h1이 없다) Astro 스코프 스타일이라 이 h1 셀렉터는 <Content />가 슬롯으로 렌더하는
  // 내용에는 적용되지 않는다.
  h1 {
    color: $grey-1;
    font-size: 2.5rem;
    font-weight: 400;
  }

  // PublishDate.vue의 .time
  .publishedAt {
    display: block;
    margin-top: 1.5rem;
    // 원본은 4rem이었고, 그 아래 썸네일의 margin-bottom(80px)이 본문 앞 간격을
    // 결정했다 — 첫 요소가 h2든 인용문이든 47편 모두 80px로 일정했다(실측). 썸네일이
    // 빠진 지금 4rem을 두면 h2로 시작하는 11편만 80px(h2의 margin-top과 상쇄), 나머지
    // 36편은 64px이 되어 글마다 달라진다. 5rem으로 올려 이전 간격을 그대로 복원한다.
    margin-bottom: 5rem;
    color: $grey-5;
    font-size: 1rem;
  }
</style>
